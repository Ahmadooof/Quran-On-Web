{
  "name": "quran-app",
  "version": "1.0.0",
  "description": "Quran Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "npm run fetch:fonts && npm run build:mushaf",
    "fetch:fonts": "node scripts/fetch-fonts.js",
    "build:mushaf": "node scripts/build-mushaf.js",
    "fetch:reference": "node tests/fetch-reference.js",
    "test": "npm run test:data && npm run test:fonts && npm run test:perf && npm run test:pages",
    "test:data": "node tests/check-data.js",
    "test:fonts": "python tests/check-fonts.py",
    "test:perf": "node tests/check-perf.js",
    "test:pages": "node tests/check-pages.js",
    "build:pages": "node scripts/build-pages.js",
    "sync:android": "node scripts/sync-android-assets.js",
    "indexnow": "node scripts/indexnow.js",
    "docker:release": "node scripts/docker-release.js",
    "reclaim": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vm-reclaim.ps1",
    "fonts:ttf": "node scripts/fonts-to-ttf.js",
    "fonts:glyphs": "node scripts/glyph-maps.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
