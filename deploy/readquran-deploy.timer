[Unit]
Description=Check for a new release every minute

[Timer]
# Not at boot exactly: give the network and docker a moment to settle first.
OnBootSec=2min
OnUnitActiveSec=60s
# Spread the check so it does not land on the same second every time.
RandomizedDelaySec=15
Persistent=true

[Install]
WantedBy=timers.target
