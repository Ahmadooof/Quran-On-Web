<?xml version="1.0" encoding="utf-8"?>
<!-- The same card, tinted: for the row that is not like the others. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_soft">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/accent_soft" />
            <!-- Accent border completes the "this is the one playing" signal. -->
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
