<?xml version="1.0" encoding="utf-8"?>
<!--
  Night, taken from the stylesheet's body.dark-mode block so the two readers
  darken alike.

  The ground is lifted off black and the type pulled back from white, which is
  what makes a long read comfortable; the stylesheet notes it still measures
  9:1, well past AAA. The ornament — the surah names and the Basmalah — turns
  gold rather than staying blue, as it does on the web.
-->
<resources>
    <color name="paper">#1A1F25</color>
    <color name="ink">#A2A7AD</color>
    <color name="chrome">#1E242A</color>

    <color name="accent">#3F9BD1</color>
    <color name="accent_soft">#243F9BD1</color>
    <color name="surface">#181D22</color>
    <color name="surface_2">#1E242A</color>
    <color name="line">#2A3138</color>
    <color name="text">#A2A7AD</color>
    <color name="text_mute">#8B939C</color>
    <color name="ornament">#D9B95F</color>
    <!-- Knocked out of the filled pill. Not pure white at night: it glares. -->
    <color name="on_dark">#0F1317</color>
</resources>
