<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawing into the camera cutout, which is where the attribute for it arrived.

  Without this the window stops short of the cutout while the phone's bars are
  hidden and starts again below them when they are shown, so asking for the
  chrome moved the page — the very thing a page must never do. Told to use the
  short edges, the window is the whole screen at all times and nothing resizes.

  The window covering that strip is not the same as the page using it. The
  reader holds its pages below it by a fixed margin, so what shows beside the
  camera is the window's own paper: full screen to look at, and no word of the
  mushaf under the lens.
-->
<resources>
    <style name="Theme.Quran" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
