<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The mushaf's paper. The window wears it too, so the moment before the
         page has drawn anything looks like the page it is about to show rather
         than a flash of black and then white. Kept in step by hand with the
         paper colour in public/css/style.css. -->
    <color name="paper">#FFFDF7</color>
    <color name="ink">#1A1A1A</color>
    <color name="chrome">#EAF1F7</color>

    <!-- The rest of the palette, the same values the stylesheet's :root sets,
         so the app and the site are one design and not two. -->
    <color name="accent">#1A6FA3</color>
    <color name="accent_soft">#261A6FA3</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#F5F9FD</color>
    <color name="line">#DCE8F2</color>
    <color name="text">#16283A</color>
    <color name="text_mute">#6A869B</color>
    <color name="on_dark">#FFFFFF</color>

    <!-- The surah names and the Basmalah. Blue by day with everything else;
         gold at night, which is the one colour the dark stylesheet changes
         rather than merely darkens. -->
    <color name="ornament">#1A6FA3</color>
</resources>
