<?xml version="1.0" encoding="utf-8"?>
<!--
  The index, laid out as the web reader's drawer is: a strip of three tabs and
  then whichever pane they choose, each owning the height left over.

  It reads right to left throughout, whatever language it is set to. The
  language switch changes the words and nothing else: this is a mushaf, it is
  read from the right, and an English label does not turn the book around.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true"
    android:background="@color/surface_2">

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@drawable/tab_strip"
        android:elevation="3dp"
        android:padding="5dp"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/tab_index"
            style="@style/DrawerTab"
            android:text="@string/tab_index" />

        <TextView
            android:id="@+id/tab_listen"
            style="@style/DrawerTab"
            android:text="@string/tab_listen" />

        <TextView
            android:id="@+id/tab_settings"
            style="@style/DrawerTab"
            android:text="@string/tab_settings" />

        <!-- Not a tab: there is no pane behind it. It is the way straight back
             to the page you were on, put here because that is what most people
             opening the app want and they should not have to look for it. -->
        <ImageView
            android:id="@+id/resume"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:contentDescription="@string/resume"
            android:background="@drawable/tab_off"
            android:src="@drawable/ic_bookmark" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/pane_index"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pane_listen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Who is reading. Tapped, it offers the others. -->
            <LinearLayout
                android:id="@+id/row_reciter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listen_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/pane_marks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/marks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/pane_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/row_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!--
      What is playing, if anything is. Lives outside the tab panes so it is
      visible on every tab — including the surah list — whenever a recitation
      is running. Shown and hidden by SurahListActivity.player().
    -->
    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:background="@drawable/bar_round"
        android:elevation="8dp"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Primary action: filled accent circle. -->
        <ImageView
            android:id="@+id/p_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="14dp"
            android:contentDescription="@string/play"
            android:background="@drawable/bg_circle_accent"
            android:tint="@color/on_dark"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/p_where"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <!-- Secondary controls: muted. -->
        <ImageView
            android:id="@+id/p_locate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:contentDescription="@string/locate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_locate" />

        <ImageView
            android:id="@+id/p_reciter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:contentDescription="@string/reciter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_reciter" />

        <!-- Tint updated in code when a loop mode is active. -->
        <ImageView
            android:id="@+id/p_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:contentDescription="@string/repeat"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_repeat" />

        <ImageView
            android:id="@+id/p_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:contentDescription="@string/close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_mute"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</LinearLayout>
