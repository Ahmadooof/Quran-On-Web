<?xml version="1.0" encoding="utf-8"?>
<!--
  The reader: the page, and a bar that is not there until it is asked for.

  A phone screen holds exactly one page of this mushaf and nothing else, so
  everything that is not the page waits off screen until a tap brings it in —
  the phone's own bars included.

  The bar says nothing about where you are. The page already prints that across
  its own head, in the mushaf's hand, which is better than repeating it in the
  phone's. What is left is the two things the page cannot do for itself: keep
  this page, and go back.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:background="@color/chrome"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/to_menu"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/back_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/to_menu"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/mark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/mark_page"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_bookmark_off" />
    </LinearLayout>

    <!--
      The player, when there is one. It floats at the foot of the page rather
      than being ruled off from it: the same rounded bar the listening pane
      uses, so the two are plainly the same thing in two places.
    -->
    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:background="@drawable/bar_round"
        android:elevation="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/p_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="10dp"
                android:contentDescription="@string/play"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/p_where"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/p_locate"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:contentDescription="@string/locate"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_locate" />

            <ImageView
                android:id="@+id/p_reciter"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:contentDescription="@string/reciter"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reciter" />

            <ImageView
                android:id="@+id/p_repeat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:contentDescription="@string/repeat"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_repeat" />

            <ImageView
                android:id="@+id/p_close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:contentDescription="@string/close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
