# Cloudflare Pages only: the same headers nginx sends (deploy/security-headers.conf).
# nginx ignores this file. A header set by two matching rules is joined with a
# comma, so Cache-Control is only ever set by one rule per path.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://audio.readqurantoday.com; frame-src https://audio.readqurantoday.com; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; object-src 'none'

# Each page font never changes once built
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# The pages.dev copy must not compete with readqurantoday.com in search
https://:project.pages.dev/*
  X-Robots-Tag: noindex
